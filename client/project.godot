; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[  ]
_global_script_class_icons={
}

[application]

config/name="Cirya Online"
run/main_scene="res://menus/MainMenu.tscn"
boot_splash/image="res://assets/interface/cirya-start-blur.png"
config/icon="res://assets/sat.png"

[autoload]

Server="*res://Server.tscn"
Settings="*res://Settings.gd"
Match="*res://Match.gd"

[display]

window/size/width=1920
window/size/height=1080
mouse_cursor/custom_image="res://assets/cursors/cursor-select.png"
window/stretch/mode="2d"
window/stretch/aspect="keep_height"

[physics]

common/physics_fps=110
3d/active_soft_world=false
3d/default_gravity_vector=Vector3( 0, -1.1, 0 )

[rendering]

gles3/shaders/shader_compilation_mode=2
environment/default_environment="res://default_env.tres"
